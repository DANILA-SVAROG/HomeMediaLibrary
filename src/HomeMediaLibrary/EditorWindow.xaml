<Window x:Class="HomeMediaLibrary.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись медиатеки" Width="760" Height="800" MinWidth="660" MinHeight="590"
        WindowStartupLocation="CenterOwner">
    <Window.Resources><ResourceDictionary Source="Styles.xaml"/></Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="FormTitle" Text="Добавить в медиатеку" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,10,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Название *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TitleBox"/>
                    <TextBlock Text="Тип *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="KindBox" SelectedIndex="0" SelectionChanged="Kind_Changed">
                        <ComboBoxItem Content="Фильм"/><ComboBoxItem Content="Сериал"/>
                    </ComboBox>
                    <TextBlock x:Name="AuthorLabel" Text="Режиссёр" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AuthorBox"/>
                    <TextBlock Text="Год выхода" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="YearBox" ToolTip="Четыре цифры; для сериала — год начала"/>
                    <StackPanel x:Name="DurationPanel"><TextBlock Text="Длительность, минут" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DurationBox"/></StackPanel>
                    <StackPanel x:Name="SeasonsPanel" Visibility="Collapsed"><TextBlock Text="Число сезонов" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SeasonsBox"/></StackPanel>
                    <TextBlock Text="Жанры через запятую" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="GenresBox"/>
                    <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DescriptionBox" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    <TextBlock Text="Ссылка IMDb" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ImdbBox" ToolTip="https://www.imdb.com/title/..."/>
                    <TextBlock Text="Статус просмотра" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="StatusBox" SelectedIndex="0"><ComboBoxItem Content="В планах"/><ComboBoxItem Content="Просмотрено"/></ComboBox>
                    <CheckBox x:Name="PurchasedBox" Content="Куплено" Margin="0,14,0,12"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Обложка" Style="{StaticResource FieldLabel}"/>
                    <Border Background="#E5EAEF" Height="270"><Image x:Name="CoverPreview" Stretch="Uniform"/></Border>
                    <Button Content="Выбрать JPEG или PNG" Click="ChooseCover_Click" Margin="0,10,0,8"/>
                    <Button Content="Убрать обложку" Click="RemoveCover_Click" Margin="0,0,0,8"/>
                    <TextBlock x:Name="CoverName" TextWrapping="Wrap" Style="{StaticResource SmallText}"/>
                    <TextBlock Text="Обязательно только название и тип. Остальные сведения можно добавить позже." TextWrapping="Wrap" Margin="0,20,0,0" Foreground="#617383"/>
                    <TextBlock Text="Данные из IMDb вводятся вручную. Для открытия страницы сохраните её ссылку." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#617383"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#A33225" TextWrapping="Wrap" Margin="0,12,0,8" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Сохранить" IsDefault="True" Background="#CCE0D7" Click="Save_Click"/>
            <Button Content="Отмена" IsCancel="True" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
