<Window x:Class="HomeMediaLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Домашняя медиатека" Width="1240" Height="820" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen">
    <Window.Resources><ResourceDictionary Source="Styles.xaml"/></Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Домашняя медиатека" FontSize="27" FontWeight="SemiBold"/>
                <TextBlock Text="Фильмы и сериалы в вашей коллекции" Style="{StaticResource SmallText}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddButton" Content="Добавить" Background="#CCE0D7" IsEnabled="{Binding CanChange}" Click="Add_Click"/>
                <Button x:Name="EditButton" Content="Редактировать" IsEnabled="{Binding CanEditSelection}" Click="Edit_Click"/>
                <Button x:Name="DeleteButton" Content="Удалить" IsEnabled="{Binding CanEditSelection}" Click="Delete_Click"/>
                <Button x:Name="ExportButton" Content="Экспорт в JSON" IsEnabled="{Binding CanChange}" Click="Export_Click" Margin="0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#DBE2E7" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="Название или автор" Margin="0,0,0,5"/>
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по части названия или имени автора"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Жанр" Margin="0,0,0,5"/>
                    <ComboBox x:Name="GenreFilter" ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Год" Margin="0,0,0,5"/>
                    <ComboBox x:Name="YearFilter" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="Тип" Margin="0,0,0,5"/>
                    <ComboBox x:Name="KindFilter" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"/>
                </StackPanel>
                <Button Grid.Column="4" Content="Сбросить фильтры" Click="Reset_Click" VerticalAlignment="Bottom" Margin="0"/>
                <StackPanel Grid.Row="1" Margin="0,12,12,0"><TextBlock Text="Просмотр" Margin="0,0,0,5"/>
                    <ComboBox x:Name="StatusFilter" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,12,0"><TextBlock Text="Покупка" Margin="0,0,0,5"/>
                    <ComboBox x:Name="PurchaseFilter" ItemsSource="{Binding Purchases}" SelectedItem="{Binding SelectedPurchase}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,12,12,0"><TextBlock Text="Сортировка" Margin="0,0,0,5"/>
                    <ComboBox x:Name="SortFilter" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding CountText}" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#FFF0DE" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasLoadError, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="#823E1A"/>
                <TextBlock Text="{Binding DataPath}" TextWrapping="Wrap" Margin="0,6"/>
                <Button Content="Повторить загрузку" Click="Reload_Click" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
            <ListBox x:Name="Catalog" ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItem}"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="Catalog_DoubleClick">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template"><Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" BorderBrush="#DBE2E7" BorderThickness="2" CornerRadius="6" Background="White"><ContentPresenter/></Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#3D7764"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F4FAF7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <StackPanel Width="178" Margin="10">
                        <Border Background="#E5EAEF" Height="210"><Image Source="{Binding CoverPath, Converter={StaticResource Cover}}" Stretch="Uniform"/></Border>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Height="42" Margin="0,8,0,2" ToolTip="{Binding Title}"/>
                        <TextBlock Text="{Binding Author}" TextTrimming="CharacterEllipsis" Style="{StaticResource SmallText}"/>
                        <TextBlock Margin="0,5,0,0"><Run Text="{Binding TypeName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding YearText, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="{Binding GenreText}" TextTrimming="CharacterEllipsis" Style="{StaticResource SmallText}" Margin="0,3"/>
                        <TextBlock Text="{Binding ShortInfo}" Style="{StaticResource SmallText}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="#356750"/>
                        <TextBlock Text="{Binding PurchaseText}" Style="{StaticResource SmallText}"/>
                    </StackPanel>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyMessage" Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Margin="30" FontSize="17"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"/>
            <Border Grid.Column="2" Background="White" BorderBrush="#DBE2E7" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <TextBlock Text="Выберите карточку, чтобы посмотреть все сведения." TextWrapping="Wrap" Foreground="#617383" VerticalAlignment="Center" TextAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedItem.Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedItem.TypeName}" Foreground="#617383" Margin="0,5,0,12"/>
                            <Image Source="{Binding SelectedItem.CoverPath, Converter={StaticResource Cover}}" Height="200" Stretch="Uniform" HorizontalAlignment="Left"/>
                            <TextBlock Text="Автор" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding SelectedItem.Author}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedItem.YearText}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding SelectedItem.GenreText}" TextWrapping="Wrap" Margin="0,6"/>
                            <TextBlock Text="{Binding SelectedItem.ShortInfo}" TextWrapping="Wrap"/>
                            <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding SelectedItem.Description}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedItem.StatusText}" Foreground="#356750" Margin="0,14,0,4"/>
                            <TextBlock Text="{Binding SelectedItem.PurchaseText}" Margin="0,0,0,12"/>
                            <Button x:Name="WatchButton" Content="Изменить статус просмотра" IsEnabled="{Binding CanEditSelection}" Click="Watch_Click" Margin="0,0,0,8"/>
                            <Button x:Name="PurchaseButton" Content="Изменить отметку покупки" IsEnabled="{Binding CanEditSelection}" Click="Purchase_Click" Margin="0,0,0,8"/>
                            <Button x:Name="ImdbButton" Content="Открыть в IMDb" IsEnabled="{Binding CanOpenImdb}" Click="Imdb_Click" Margin="0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#4E6273"/>
    </Grid>
</Window>
